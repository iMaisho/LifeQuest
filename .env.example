# Variables d'environnement requises pour lancer l'application en production.
# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# Clé secrète pour signer les sessions et les tokens Phoenix.
# Générer avec : mix phx.gen.secret
SECRET_KEY_BASE=

# URL de connexion à la base de données PostgreSQL.
# Format : ecto://utilisateur:motdepasse@hote/nom_base
DATABASE_URL=ecto://postgres:postgres@localhost/lifequest_prod

# Domaine public de l'application, utilisé pour construire les URLs dans les emails.
PHX_HOST=localhost

# Port sur lequel l'application écoute les connexions entrantes.
PORT=4000

# Taille du pool de connexions à la base de données (optionnel, défaut : 10).
# POOL_SIZE=10

# Activer IPv6 pour la connexion à la base de données (optionnel).
# ECTO_IPVV6=true
