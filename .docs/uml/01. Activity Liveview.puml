@startuml Lifequest – Interactions entre couches
!theme plain

skinparam backgroundColor white
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceGroupBorderColor #999999

actor "Navigateur" as browser #e8e8e8
participant "Router\n(Plugs)" as router #b8d4f0
participant "LiveView" as lv #a0c8e8
participant "Context" as ctx #c8e0b0
participant "Ecto\n(Repo)" as repo #f0d8a0
database "PostgreSQL" as db #e0e0e0

browser -> router : GET /finances
activate router

router -> router : Pipeline :browser\n(CSRF, session, Scope)
router -> lv : mount/3
activate lv

lv -> ctx : get_financial_profile!(scope, id)
activate ctx

ctx -> repo : Repo.get_by!(FinancialProfile, id, user_id)
activate repo

repo -> db : SELECT * FROM finances\nWHERE user_id = $1
activate db
db --> repo : rows
deactivate db

repo --> ctx : [%FinancialProfile{}, ...]
deactivate repo

ctx --> lv : [%FinancialProfile{}, ...]
deactivate ctx

lv -> lv : assign(socket, :finances, [...])
lv -> lv : render/1
lv --> router : HTML complet
deactivate lv

router --> browser : HTTP 200
deactivate router

@enduml
